# Password users type at /login (shared across the team)
MOCKUP_PASSWORD=change-me

# Random opaque value the server sets as the auth cookie after a valid login.
# Generate any unguessable string: `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
# Must differ from MOCKUP_PASSWORD.
MOCKUP_AUTH_TOKEN=change-me-too-something-long-and-random
